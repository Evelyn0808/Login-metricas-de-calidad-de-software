# Secreto de sesion (cambialo por una cadena larga y aleatoria)
SESSION_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Puerto del servidor
PORT=3000

# Entorno: development | production
NODE_ENV=development

# Intentos fallidos permitidos antes del bloqueo temporal (3 intentos seguidos)
MAX_FAILED_ATTEMPTS=3

# Minutos de penalización
LOCKOUT_MINUTES=15

# SMTP Remitente (cuenta encargada de enviar los códigos a los usuarios)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=metricaslogin@gmail.com
SMTP_PASS=tu.contrasena_de_aplicacion_de_gmail
SMTP_FROM=metricaslogin@gmail.com

# Ruta opcional de la base SQLite (por defecto data/app.db)
# DB_PATH=./data/app.db
